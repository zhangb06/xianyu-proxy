# 数据目录；留空使用平台默认目录
# Linux: ~/.local/share/xianyu-lite
# Windows: %LOCALAPPDATA%\XianyuLite
XY_DATA_DIR=

XY_HOST=127.0.0.1
XY_PORT=8089

# 留空时首次启动自动生成并写入数据库，请备份
XY_SECRET_KEY=

XY_LOG_LEVEL=INFO

# 协议参数
XY_WS_URL=wss://wss-goofish.dingtalk.com/
XY_HEARTBEAT_INTERVAL=15
XY_HTTP_TIMEOUT=30

# 每账号两条消息之间的最小间隔（秒）
XY_SEND_MIN_INTERVAL=2.0

# 账号验证方式：manual | auto_fallback
XY_VERIFICATION_MODE=manual
